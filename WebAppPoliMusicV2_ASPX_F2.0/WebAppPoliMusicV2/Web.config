<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 50MB = 50 * 1024 * 1024 bytes -->
    <add key="maxSongLength" value="52428800" />
    <add key="albumImagePath" value="~/albumImages/" />
    <add key="artistImagePath" value="~/artistImages/" />
    <add key="userPhotoPath" value="~/userImages/" />
    <add key="songFolderPath" value="~/songFiles/" />
    <add key="playlistFolderPath" value="~/playlistImages/" />
  </appSettings>
  <connectionStrings>
    <!-- Entorno local: SQL Server en modo solo Windows (autenticación integrada) -->
    <add name="BDD_PoliMusicConnectionString"
         connectionString="Data Source=localhost;Initial Catalog=BDD_PoliMusic;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
    <!-- Cadena original del laboratorio (requiere habilitar autenticación mixta en SQL Server):
    <add name="BDD_PoliMusicConnectionString"
         connectionString="Data Source=localhost;Initial Catalog=BDD_PoliMusic;User ID=usr_polimusic;Password=Politecnica1"
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
  <system.web>
    <compilation debug="true" />
    <!-- 50MB expresados en KB -->
    <httpRuntime maxRequestLength="51200" executionTimeout="600" />
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" defaultUrl="Default.aspx" timeout="20" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="Off" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <pages />
    <sessionState mode="InProc" timeout="20" />
  </system.web>
  <!-- Páginas públicas: login, registro y logout -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="SignUp.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Logout.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Archivos estáticos (por si el pipeline integrado los procesa) -->
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="songFiles">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
      <httpRuntime maxRequestLength="51200" />
    </system.web>
  </location>
  <location path="userImages">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="albumImages">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="artistImages">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="playlistImages">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 50MB en bytes -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
